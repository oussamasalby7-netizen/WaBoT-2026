APP_NAME=WaBoT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wabot
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Frontend SPA (used for CORS and redirects)
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Sanctum
SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_TOKEN_EXPIRATION=10080

# Pusher / Laravel WebSockets
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Stripe
STRIPE_WEBHOOK_SECRET=

# Baileys WhatsApp microservice
BAILEYS_SERVICE_URL=http://127.0.0.1:3001
BAILEYS_SERVICE_SECRET=

# Trusted reverse proxies (comma-separated IPs, or * behind known LB)
TRUSTED_PROXIES=

# Dev-only: enables /api/test/* routes (must be false in production)
TEST_MODE=false
