APP_NAME=WaBoT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wabot-2026-production.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Use Railway MySQL plugin variables (auto-injected as MYSQL* or set manually):
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_DATABASE=${{MYSQLDATABASE}}
DB_USERNAME=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}
# If using Railpack builder, also set:
# RAILPACK_PHP_EXTENSIONS=pdo_mysql,mbstring,bcmath,fileinfo

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FRONTEND_URL=https://wa-bo-t-2026.vercel.app
CORS_ALLOWED_ORIGINS=https://wa-bo-t-2026.vercel.app
SANCTUM_STATEFUL_DOMAINS=wa-bo-t-2026.vercel.app
SANCTUM_TOKEN_EXPIRATION=10080

PUSHER_APP_ID=wabot-app
PUSHER_APP_KEY=wabot-key-local
PUSHER_APP_SECRET=wabot-secret-local
PUSHER_HOST=wabot-2026-production.up.railway.app
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

TRUSTED_PROXIES=*

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

STRIPE_WEBHOOK_SECRET=

BAILEYS_SERVICE_URL=
BAILEYS_SERVICE_SECRET=

TEST_MODE=false
