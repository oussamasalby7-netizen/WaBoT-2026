# HTTP server
PORT=3001
BIND_HOST=127.0.0.1

# Shared secret (must match BAILEYS_SERVICE_SECRET in Laravel .env)
SERVICE_SECRET=

# Laravel API base URL
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Baileys session storage (use a persistent volume in production)
SESSION_DIR=./sessions

LOG_LEVEL=info

# Optional: pin WhatsApp Web version (format: 2,3000,1035194821)
# WA_WEB_VERSION=
# WA_BROWSER=windows
